{
  "name": "agentflow-desktop",
  "productName": "AgentFlow",
  "version": "0.4.3",
  "description": "本地多智能体工作台，TokenLens 风格的可审计任务编排",
  "main": "main.cjs",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test.cjs",
    "check": "node --check main.cjs && node --check preload.cjs && node --check lib/engine.cjs && node --check lib/providers.cjs && node --check ui/app.js",
    "package": "node scripts/package.cjs",
    "test:packaging": "node --test scripts/package.test.cjs",
    "build:telemetry": "node scripts/build-telemetry.cjs",
    "verify:release": "node scripts/verify-artifacts.cjs",
    "smoke:packaged": "node scripts/smoke-packaged.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.7.2",
    "electron-winstaller": "5.4.4"
  },
  "buildNumber": 10,
  "author": "AgentFlow contributors"
}
